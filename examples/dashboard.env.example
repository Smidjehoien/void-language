# The repository does not auto-load .env files. Export these variables in the
# shell or configure them in the process manager that starts the dashboard.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000
# Set to 1 only when an explicit non-loopback bind is intended.
DASHBOARD_ALLOW_NON_LOOPBACK=0

# No OPENAI_API_KEY is needed by the current local dashboard executor.
